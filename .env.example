# Copie para .env.local (ignorado pelo Git) e ajuste.
# Endereço do sistema (lhamalog-web): "Entrar", "Começar grátis" e "Contratar" levam para lá.
# Vazio: "Entrar" e "Começar grátis" usam /sign-in e /sign-up deste site, e "Contratar" mostra "indisponível".
VITE_APP_URL=
# API do Core, de onde vem a lista pública de planos (GET /api/v1/planos).
VITE_API_URL=http://localhost:8080
# Só desenvolvimento: true mostra planos falsos sem o Core (o build de produção ignora).
VITE_USAR_DADOS_FALSOS=true
