# Copie para .env.local (ignorado pelo Git) e ajuste.
# Endereço do sistema (lhamalog-web): "Acessar Página", "Começar grátis" e "Contratar" levam para lá.
# Vazio: usa o padrão https://app.lhamalog.com. Só preencha para apontar para outro ambiente (por exemplo, o de testes).
VITE_APP_URL=
# API do Core, de onde vem a lista pública de planos (GET /api/v1/planos).
VITE_API_URL=http://localhost:8080
# Só desenvolvimento: true mostra planos falsos sem o Core (o build de produção ignora).
VITE_USAR_DADOS_FALSOS=true
